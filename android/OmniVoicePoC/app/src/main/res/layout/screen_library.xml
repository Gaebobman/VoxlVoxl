<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenLibrary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Voxl.Wordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <ImageButton
            android:id="@+id/openDev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dev_title"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="6dp" />

    <TextView
        style="@style/Voxl.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voices_title" />

    <Space android:layout_width="match_parent" android:layout_height="7dp" />

    <TextView
        android:id="@+id/voicesBody"
        style="@style/Voxl.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voices_body" />

    <Space android:layout_width="match_parent" android:layout_height="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/voiceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Space android:layout_width="match_parent" android:layout_height="12dp" />

    <Button
        android:id="@+id/addVoice"
        style="@style/Voxl.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/dashed_add"
        android:text="@string/voices_add" />

    <Space android:layout_width="match_parent" android:layout_height="12dp" />

    <LinearLayout
        android:id="@+id/privacyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_shield" />

        <TextView
            android:id="@+id/privacyLine"
            style="@style/Voxl.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/privacy_short"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/goCompose"
        style="@style/Voxl.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/compose_go" />
</LinearLayout>
