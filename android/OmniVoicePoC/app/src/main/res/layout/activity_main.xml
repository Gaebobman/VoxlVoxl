<?xml version="1.0" encoding="utf-8"?>
<!--
  Root: the ground layer, then one screen at a time on top. A state machine in
  MainActivity toggles which child of @id/screens is visible — the flow is
  linear enough (install -> enroll -> verify -> voices -> compose -> generating
  -> result) that a navigation graph would add indirection and no clarity.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ai.omnivoice.poc.ui.GroundView
        android:id="@+id/ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/screens"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/screen_first_run" />
        <include layout="@layout/screen_library" />
        <include layout="@layout/screen_enroll" />
        <include layout="@layout/screen_verify" />
        <include layout="@layout/screen_compose" />
        <include layout="@layout/screen_generating" />
        <include layout="@layout/screen_result" />
        <include layout="@layout/screen_dev" />
        <include layout="@layout/screen_licenses" />
    </FrameLayout>
</FrameLayout>
