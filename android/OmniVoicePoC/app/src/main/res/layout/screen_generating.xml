<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenGenerating"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            style="@style/Voxl.Wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/Voxl.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/gen_tag" />
    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="14dp" />

    <TextView
        android:id="@+id/genText"
        style="@style/Voxl.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <Space android:layout_width="match_parent" android:layout_height="16dp" />

    <!-- the instrument -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/genEta"
                style="@style/Voxl.Readout.Huge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—" />

            <TextView
                android:id="@+id/genEtaUnit"
                style="@style/Voxl.Readout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingBottom="5dp"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/genStep"
                    style="@style/Voxl.Readout.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/genCells"
                    style="@style/Voxl.Readout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ai.omnivoice.poc.ui.CodebookLadderView
            android:id="@+id/ladder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />

        <TextView
            style="@style/Voxl.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/gen_ladder"
            android:textSize="10.5sp" />
    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="12dp" />

    <Button
        android:id="@+id/genCancel"
        style="@style/Voxl.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/gen_cancel"
        android:textSize="14sp" />

    <!-- the thermal note is about the run in progress, so it stays with it -->
    <LinearLayout
        android:id="@+id/genThermal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/glass_chip"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="1dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_thermal" />

        <TextView
            style="@style/Voxl.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/gen_thermal" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="18dp" />

    <!-- the wait is not dead time. Bottom-anchored so the keyboard lifts it
         instead of covering it. -->
    <TextView
        style="@style/Voxl.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gen_next" />

    <LinearLayout
        android:id="@+id/queueList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/glass_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@+id/queueInput"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/pretendard"
            android:hint="@string/gen_queue_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/text_faint"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/queueAdd"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/gen_next"
            android:src="@drawable/ic_plus" />
    </LinearLayout>
</LinearLayout>
