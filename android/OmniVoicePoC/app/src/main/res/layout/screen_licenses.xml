<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenLicenses"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/licensesBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="-8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/gen_cancel"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Voxl.Wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/licenses_title" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="16dp" />

        <TextView
            style="@style/Voxl.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/licenses_body" />

        <Space android:layout_width="match_parent" android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Voxl.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/licenses_attribution"
                android:textColor="@color/text"
                android:textSize="12.5sp" />

            <TextView
                style="@style/Voxl.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/licenses_terms"
                android:textSize="11.5sp" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="16dp" />

        <LinearLayout
            android:id="@+id/licensesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
