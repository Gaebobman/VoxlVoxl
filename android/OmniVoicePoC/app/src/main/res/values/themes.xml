<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The dark "material" direction from the design canvas. Kept as a real theme
      rather than per-view styling so system widgets (dialogs, spinners, the
      text cursor) inherit it too.
    -->
    <style name="Theme.VoxlVoxl" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
