<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The dark "material" direction from the design canvas. Kept as a real theme
      rather than per-view styling so system widgets (dialogs, spinners, the
      text cursor) inherit it too.
    -->
    <style name="Theme.VoxlVoxl" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.VoxlVoxl.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.VoxlVoxl.Dialog</item>
    </style>

    <!--
      Dialogs inherited the platform's grey, which reads as another app's
      surface dropped on top of this one. They are the same dark glass as
      everything else, in the same typeface.
    -->
    <style name="Theme.VoxlVoxl.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:windowTitleStyle">@style/Voxl.DialogTitle</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/Voxl.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Voxl.DialogButton.Quiet</item>
    </style>
</resources>
