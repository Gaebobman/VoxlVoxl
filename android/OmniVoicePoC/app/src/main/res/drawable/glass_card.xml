<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="290" android:startColor="#33EDA13F" android:endColor="#0DEDA13F" />
            <stroke android:width="1dp" android:color="#8CEDA13F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="290" android:startColor="#1AFFFFFF" android:endColor="#08FFFFFF" />
            <stroke android:width="1dp" android:color="#21FFFFFF" />
        </shape>
    </item>
</selector>
