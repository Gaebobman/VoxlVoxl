<?xml version="1.0" encoding="utf-8"?>
<!--
  A glass panel. Two layers: the translucent body, then a one-pixel top edge
  that reads as a specular highlight. No runtime blur — the backdrop is already
  low-frequency (GroundView's gradients and its softened spectrum), so blurring
  it again would cost GPU during a CPU-bound job and change almost nothing.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="290"
                android:startColor="#26FFFFFF"
                android:endColor="#0DFFFFFF"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#2BFFFFFF" />
        </shape>
    </item>
    <item android:bottom="-2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#47FFFFFF" />
        </shape>
    </item>
</layer-list>
