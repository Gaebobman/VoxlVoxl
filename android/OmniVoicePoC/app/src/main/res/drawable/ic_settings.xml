<?xml version="1.0" encoding="utf-8"?>
<!--
  Three sliders, not a gear and definitely not a sun.

  This opens the developer screen, which is step count and thread count. The
  icon was a circle with eight rays, which every phone user reads as a
  brightness or theme toggle. Sliders say "there are values to adjust behind
  this", which is exactly what is behind it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24"
    android:tint="#9EF6F1EA">
    <!-- tracks -->
    <path android:pathData="M4,7h16M4,12h16M4,17h16"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="1.8"
        android:fillColor="#00000000" android:strokeLineCap="round" />
    <!-- knobs, each at a different position so the row reads as settings -->
    <path android:pathData="M9,7m-2.1,0a2.1,2.1 0 1,0 4.2,0a2.1,2.1 0 1,0 -4.2,0"
        android:fillColor="#FF0A0910" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.8" />
    <path android:pathData="M16,12m-2.1,0a2.1,2.1 0 1,0 4.2,0a2.1,2.1 0 1,0 -4.2,0"
        android:fillColor="#FF0A0910" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.8" />
    <path android:pathData="M11,17m-2.1,0a2.1,2.1 0 1,0 4.2,0a2.1,2.1 0 1,0 -4.2,0"
        android:fillColor="#FF0A0910" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.8" />
</vector>
